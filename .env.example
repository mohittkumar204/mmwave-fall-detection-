# =============================================================================
# Texas Instruments IWR6843 Fall Detection System - Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit your real .env!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ESP32 Emergency Fall Buzzer Alert
# -----------------------------------------------------------------------------
# Method 1: USB Serial Connection (e.g., COM3, COM5, /dev/ttyUSB0, or AUTO)
ESP32_PORT=
ESP32_BAUD=115200

# Method 2: Wireless Wi-Fi UDP Connection (Optional, leave blank if using USB Serial)
ESP32_WIFI_IP=
ESP32_WIFI_PORT=4210

# Beep Pattern: SIREN (rapid emergency pulse), DOUBLE_BEEP, PULSE, CONTINUOUS
ESP32_BEEP_PATTERN=SIREN

# Duration in seconds to sound buzzer before auto-silence
ESP32_HOLD_SECONDS=5.0

# Master toggle for ESP32 alert (True/False)
ESP32_ENABLED=True


# -----------------------------------------------------------------------------
# 2. Telegram Fall Notification Bot
# -----------------------------------------------------------------------------
# Master toggle for Telegram alert (True/False)
TELEGRAM_ENABLED=True

# Your Telegram Bot Token obtained from @BotFather (e.g. 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=

# Target Telegram Chat ID or Channel ID (e.g. 123456789 or -1001234567890)
# (You can obtain this by messaging @userinfobot or @RawDataBot)
TELEGRAM_CHAT_ID=

# Cooldown period in seconds to prevent duplicate notifications from the same fall event
TELEGRAM_COOLDOWN_SECONDS=60
